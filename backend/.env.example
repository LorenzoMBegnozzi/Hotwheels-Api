# Copy this file to .env and fill in real values. Never commit .env.

# Email (Gmail app password, not your normal account password)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/hotwheels

# Random long string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional integrations
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Recognizer tuning
RECOGNIZER_IMG_SIZE=128
RECOGNIZER_BINS=8
RECOGNIZER_THRESHOLD=0.6
RECOGNIZER_CACHE_CONCURRENCY=5

# OCR tuning
OCR_MULTI_PASS=1
OCR_LOW_CONTRAST_MODE=1
OCR_DILATE=1
OCR_THRESHOLD_ENABLE=1
OCR_UPPERCASE=1

# Allowed CORS origins, comma separated (leave empty to use built-in defaults)
CORS_ORIGIN=
